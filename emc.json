{
    "enhConfig": {
        "enhKey": "BeConsoling",
        "spawn": "be-consoling/be-consoling.js",
        "withAttrs": {
            "base": "be-consoling",
            "level": "${base}-level",
            "ignore": "${base}-ignore",
            "_ignore": {
                "instanceOf": "Object"
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "hydrate": {
                "ifAllOf": [
                    "level",
                    "ignore",
                    "enhancedElement"
                ]
            }
        },
        "defaultPropVals": {
            "level": "log",
            "ignore": [
                "mouseover",
                "mouseout",
                "mousemove"
            ]
        }
    }
}
